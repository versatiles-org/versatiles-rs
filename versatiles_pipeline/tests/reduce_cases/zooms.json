    },
    "kept": {
      "7": {},
      "8": {
        "water": {
          "1": []
        }
      }
    }
  },
  {
    "name": "a source minzoom above the tileset's keeps the deepest zoom",
    "style": {
      "sources": {
        "s": {
          "type": "vector",
          "minzoom": 16
        }
      },
      "layers": [
        {
          "source": "s",
          "source-layer": "water"
        }
      ]
    },
    "zoom": [14],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "14": {}
    },
    "kept": {
      "14": {
        "water": {
          "1": []
        }
      }
    },
    "widening": {
      "kind": "zoom-clamp",
      "why": "MapLibre would request nothing from this source; the clamp keeps the deepest zoom."
    }
  },
  {
    "name": "a layer whose maxzoom is below its minzoom is never drawn",
