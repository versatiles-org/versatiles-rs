[
  {
    "name": "a layer drawn from z12 is dropped below it",
    "style": [
      {
        "source-layer": "water",
        "minzoom": 12,
        "paint": {
          "fill-color": ["get", "kind"]
        }
      }
    ],
    "zoom": [11, 12],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "11": {},
      "12": {
        "water": {
          "1": ["kind"]
        }
      }
    },
    "kept": {
      "11": {},
      "12": {
        "water": {
          "1": ["kind"]
        }
      }
    }
  },
  {
    "name": "a layer's maxzoom is read as inclusive",
    "style": [
      {
        "source-layer": "water",
        "maxzoom": 10
      }
    ],
    "zoom": [9, 10, 11],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "9": {
        "water": {
          "1": []
        }
      },
      "10": {},
      "11": {}
    },
    "kept": {
      "9": {
        "water": {
          "1": []
        }
      },
      "10": {
        "water": {
          "1": []
        }
      },
      "11": {}
    },
    "widening": {
      "kind": "inclusive-maxzoom",
      "why": "Hidden from map zoom 10, the layer draws z9 tiles at most; z10 is kept as well."
    }
  },
  {
    "name": "a fractional minzoom is the tile zoom it falls in",
    "style": [
      {
        "source-layer": "water",
        "minzoom": 12.5
      }
    ],
    "zoom": [11, 12],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "11": {},
      "12": {
        "water": {
          "1": []
        }
      }
    },
    "kept": {
      "11": {},
      "12": {
        "water": {
          "1": []
        }
      }
    }
  },
  {
    "name": "a fractional maxzoom is the tile zoom it falls in",
    "style": [
      {
        "source-layer": "water",
        "maxzoom": 10.5
      }
    ],
    "zoom": [10, 11],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "10": {
        "water": {
          "1": []
        }
      },
      "11": {}
    },
    "kept": {
      "10": {
        "water": {
          "1": []
        }
      },
      "11": {}
    }
  },
  {
    "name": "a layer drawn above the tileset's maxzoom is kept in its deepest tiles",
    "style": [
      {
        "source-layer": "water",
        "minzoom": 17
      }
    ],
    "zoom": [13, 14],
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        }
      ]
    },
    "drawn": {
      "13": {},
      "14": {
        "water": {
          "1": []
        }
      }
    },
    "kept": {
      "13": {},
      "14": {
        "water": {
          "1": []
        }
      }
    }
  },
  {
    "name": "a lower source maxzoom keeps a layer in the tiles the source stops at",
    "style": {
      "sources": {
        "s": {
          "type": "vector",
          "maxzoom": 12
        }
      },
      "layers": [
        {
          "source": "s",
          "source-layer": "places",
          "minzoom": 13,
          "layout": {
            "text-field": ["get", "name"]
          }
        }
      ]
    },
    "zoom": [11, 12],
    "tile": {
      "places": [
        {
          "id": 1,
          "name": "Berlin"
        }
      ]
    },
    "drawn": {
      "11": {},
      "12": {
        "places": {
          "1": ["name"]
        }
      }
    },
    "kept": {
      "11": {},
      "12": {
        "places": {
          "1": ["name"]
        }
      }
    }
  },
  {
    "name": "nothing is kept below the source's minzoom",
