[
  {
    "name": "a property read in paint stays and one never read goes",
    "style": [
      {
        "source-layer": "r",
        "paint": {
          "line-width": ["get", "width"]
        }
      }
    ],
    "zoom": 14,
    "tile": {
      "r": [
        {
          "id": 1,
          "$geometry": "LineString",
          "width": 3,
          "surface": "asphalt",
          "name": "Kantstraße",
          "ref": "B 2",
          "kind": "primary",
          "color": "red"
        }
      ]
    },
    "drawn": {
      "r": {
        "1": ["width"]
      }
    },
    "kept": {
      "r": {
        "1": ["width"]
      }
    },
    "fields": {
      "r": ["width"]
    }
  },
