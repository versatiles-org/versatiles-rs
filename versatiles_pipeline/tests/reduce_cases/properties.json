  {
    "name": "a promoted ID is kept on every source-layer",
    "style": {
      "sources": {
        "s": {
          "type": "vector",
          "promoteId": "osm_id"
        }
      },
      "layers": [
        {
          "source": "s",
          "source-layer": "w",
          "paint": {
            "fill-color": ["get", "kind"]
          }
        },
        {
          "source": "s",
          "source-layer": "l"
        }
      ]
    },
    "zoom": 14,
    "tile": {
      "w": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "osm_id": 7,
          "kind": "lake"
