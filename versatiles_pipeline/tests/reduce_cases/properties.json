        "source-layer": "w",
        "minzoom": 5,
        "maxzoom": 7,
        "layout": {
          "text-field": "{name}"
        }
      },
      {
        "source-layer": "w",
        "minzoom": 10,
        "layout": {
          "text-field": "{name}"
        }
      }
    ],
    "zoom": [8],
    "tile": {
      "w": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake",
          "name": "Wannsee"
        }
      ]
    },
    "drawn": {
      "8": {
        "w": {
          "1": []
        }
      }
    },
    "kept": {
      "8": {
        "w": {
          "1": ["name"]
        }
      }
    },
    "widening": {
      "kind": "property-zoom-span",
      "why": "`name` is read at z5–z6 and from z10; one range from 5 to 14 also keeps it at z8."
    }
  }
