  {
    "name": "a property read by one style layer stays on every feature of its source-layer",
    "style": [
      {
        "source-layer": "labels",
        "filter": ["==", "kind", "motorway"],
        "layout": {
          "text-field": "{ref}"
        }
      },
      {
        "source-layer": "labels",
        "layout": {
          "text-field": ["get", "name"]
        }
      }
    ],
    "zoom": 14,
    "tile": {
      "labels": [
        {
          "id": 1,
          "kind": "motorway",
          "ref": "A 100",
          "name": "Stadtring"
        },
        {
          "id": 2,
          "kind": "residential",
          "ref": "x",
          "name": "Kantstraße"
        }
      ]
    },
    "drawn": {
      "labels": {
        "1": ["kind", "name", "ref"],
        "2": ["kind", "name"]
      }
    },
    "kept": {
      "labels": {
        "1": ["kind", "name", "ref"],
        "2": ["kind", "name", "ref"]
      }
    },
    "widening": {
      "kind": "property-per-source-layer",
      "why": "`ref` is read only by the motorway layer, but properties are kept per source-layer."
    }
  },
  {
    "name": "a property another layer's filter reads stays, since stripping it would change that filter's answer",
    "style": [
      {
        "source-layer": "labels",
        "filter": ["!=", "kind", "motorway"]
      },
      {
        "source-layer": "labels",
        "layout": {
          "text-field": "{ref}"
        }
      }
    ],
    "zoom": 14,
    "tile": {
      "labels": [
        {
          "id": 1,
          "kind": "motorway",
          "ref": "A 100"
        },
        {
          "id": 2,
          "kind": "residential"
        }
      ]
    },
    "drawn": {
      "labels": {
        "1": ["kind", "ref"],
        "2": ["kind"]
      }
    },
    "kept": {
      "labels": {
        "1": ["kind", "ref"],
        "2": ["kind"]
      }
    }
  },
