      "w": {
        "1": ["kind", "osm_id"]
      },
      "l": {
        "1": ["osm_id"]
      }
    },
    "kept": {
      "w": {
        "1": ["kind", "osm_id"]
      },
      "l": {
        "1": ["osm_id"]
      }
