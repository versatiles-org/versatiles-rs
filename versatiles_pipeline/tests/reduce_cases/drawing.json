  {
    "name": "an icon that resolves to none keeps the feature",
    "style": [
      {
        "source-layer": "p",
        "type": "symbol",
        "layout": {
          "icon-image": [
            "match",
            ["get", "amenity"],
            "cafe",
            "icon-cafe",
            "bench",
            "icon-bench",
            ""
          ]
        }
      }
    ],
    "zoom": 14,
    "tile": {
      "p": [
        {
          "id": 1,
          "amenity": "cafe"
        },
        {
          "id": 2,
          "amenity": "bench"
        },
        {
          "id": 3,
          "amenity": "parking"
        }
      ]
    },
    "drawn": {
      "p": {
        "1": ["amenity"],
        "2": ["amenity"]
      }
    },
    "kept": {
      "p": {
        "1": ["amenity"],
        "2": ["amenity"],
        "3": ["amenity"]
      }
    },
    "widening": {
      "kind": "draws-nothing",
      "why": "`parking` gets the empty icon and no text, so nothing is drawn; only `filter` decides what is kept."
    }
  },
  {
    "name": "a layer with opacity 0 keeps its features",
    "style": [
      {
        "source-layer": "g",
        "type": "fill",
        "paint": {
          "fill-opacity": 0
        }
      }
    ],
    "zoom": 14,
    "tile": {
      "g": [
        {
          "id": 3,
          "$geometry": "Polygon",
          "kind": "a"
        }
      ]
    },
    "drawn": {},
    "kept": {
      "g": {
        "3": []
      }
    },
    "widening": {
      "kind": "draws-nothing",
      "why": "A layer with opacity 0 draws nothing, but only `filter` decides what is kept."
    }
