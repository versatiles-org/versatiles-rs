[
  {
    "name": "a fill layer keeps points and lines it does not draw",
    "style": [
      {
        "source-layer": "g",
        "type": "fill"
      }
    ],
    "zoom": 14,
    "tile": {
      "g": [
        {
          "id": 1,
          "$geometry": "Point",
          "kind": "a"
        },
        {
          "id": 2,
          "$geometry": "LineString",
          "kind": "a"
        },
        {
          "id": 3,
          "$geometry": "Polygon",
          "kind": "a"
        }
      ]
    },
    "drawn": {
      "g": {
        "3": []
      }
    },
    "kept": {
      "g": {
        "1": [],
        "2": [],
        "3": []
      }
    },
    "widening": {
      "kind": "geometry-type",
      "why": "A fill layer draws polygons only, and the reduction does not look at geometry types."
    }
  },
  {
