[
  {
    "name": "a style that draws no source-layer is refused",
    "style": [
      {
        "type": "background"
      }
    ],
    "error": "draws no source-layer"
  },
  {
    "name": "a style drawing two tilesets needs a source",
    "style": {
      "sources": {
        "shortbread": {
          "type": "vector"
        },
        "overlay": {
          "type": "vector"
        }
      },
      "layers": [
        {
          "source": "shortbread",
          "source-layer": "water",
          "filter": ["==", "kind", "lake"]
        },
        {
          "source": "overlay",
          "source-layer": "water",
          "filter": ["==", "kind", "river"]
        },
        {
          "source": "overlay",
          "source-layer": "routes"
        }
      ]
    },
    "tileset_layers": [],
    "error": "draws 2 tilesets (\"overlay\", \"shortbread\")"
  },
  {
    "name": "the refusal suggests the tileset whose layers match",
    "style": {
      "sources": {
        "shortbread": {
          "type": "vector"
        },
        "overlay": {
          "type": "vector"
        }
      },
      "layers": [
        {
          "source": "shortbread",
          "source-layer": "water",
          "filter": ["==", "kind", "lake"]
        },
        {
          "source": "overlay",
          "source-layer": "water",
          "filter": ["==", "kind", "river"]
        },
        {
          "source": "overlay",
          "source-layer": "routes"
        }
      ]
    },
    "tileset_layers": ["routes"],
    "error": "match source \"overlay\""
  },
  {
    "name": "a named source counts only its own layers",
    "style": {
      "sources": {
        "shortbread": {
          "type": "vector"
        },
        "overlay": {
          "type": "vector"
        }
      },
      "layers": [
        {
          "source": "shortbread",
          "source-layer": "water",
          "filter": ["==", "kind", "lake"]
        },
        {
          "source": "overlay",
          "source-layer": "water",
          "filter": ["==", "kind", "river"]
        },
        {
          "source": "overlay",
          "source-layer": "routes"
        }
      ]
    },
    "source": ["shortbread"],
    "zoom": 14,
    "tile": {
      "water": [
        {
          "id": 1,
          "$geometry": "Polygon",
          "kind": "lake"
        },
        {
          "id": 2,
          "$geometry": "LineString",
          "kind": "river"
        }
      ]
    },
    "drawn": {
      "water": {
        "1": ["kind"]
      }
    },
    "kept": {
      "water": {
        "1": ["kind"]
      }
    }
  },
