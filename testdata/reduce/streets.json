{
  "version": 1,
  "source": { "schema": "shortbread", "language": "de" },
  "layers": {
    "streets": {
      "properties": ["kind", "bridge", "tunnel", "service"],
      "keep": [
        {
          "minzoom": 5,
          "maxzoom": 14,
          "where": {
            "op": "and",
            "args": [
              { "op": "in", "field": "kind", "values": ["motorway", "trunk"] },
              { "op": "ne", "field": "bridge", "value": true }
            ]
          },
          "source": ["all", ["in", ["get", "kind"], ["literal", ["motorway", "trunk"]]], ["!=", ["get", "bridge"], true]]
        },
        { "minzoom": 12, "maxzoom": 14 }
      ]
    },
    "buildings": { "properties": [], "keep": [{ "minzoom": 14, "maxzoom": 14 }] }
  }
}
